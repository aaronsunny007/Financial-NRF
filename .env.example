# Copy this file to .env and fill in the values you need.
# .env is git-ignored and must never be committed.

# Where experiment output is written. Defaults to ./results
NRF_RESULTS_DIR=results

# Set to 1 to allow the deploy/ demo to call a live model.
# Leave unset or 0 for the static, offline scoring demo.
NRF_ENABLE_LIVE=0

# Port for the local demo server.
PORT=7860

# Optional: only needed if you run the hosted-model comparison backend.
# ANTHROPIC_API_KEY=
